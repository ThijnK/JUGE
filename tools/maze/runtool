#!/bin/sh
set -eu
: "${MAZE_HOME:?Set MAZE_HOME to an unpacked MAZE Linux package}"
: "${MAZE_EXPERIMENT:?Set MAZE_EXPERIMENT to a named experiment JSON file}"
# JUGE's metrics JVM can remain Java 8; MAZE and this adapter use Java 21.
if [ -n "${MAZE_JAVA_HOME:-}" ]; then
    export JAVA_HOME="$MAZE_JAVA_HOME"
fi
if [ -n "${JAVA_HOME:-}" ]; then
    java_command=$JAVA_HOME/bin/java
else
    java_command=java
fi
adapter_home=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec "$java_command" -cp "$adapter_home/lib/maze-adapter.jar:$MAZE_HOME/maze.jar" \
    sbst.runtool.Main "$MAZE_HOME" "$MAZE_EXPERIMENT"
